import os
import re
import json
from io import BytesIO
from collections import Counter
import concurrent.futures

import pandas as pd
import networkx as nx
import streamlit as st
import plotly.graph_objects as go
from dotenv import load_dotenv
from openai import AzureOpenAI
from azure.storage.blob import BlobServiceClient

# STEP 1. 환경설정
load_dotenv()
client = AzureOpenAI(
    api_key=os.getenv("OPENAI_API_KEY"),
    azure_endpoint=os.getenv("OPENAI_AZURE_ENDPOINT"),
    api_version=os.getenv("OPENAI_API_VERSION")
)
CHAT_DEPLOYMENT_NAME = os.getenv("CHAT_DEPLOYMENT_NAME")
STORAGE_CONNECTION_STRING = os.getenv("AZURE_STORAGE_CONNECTION_STRING")
CONTAINER_NAME = "mvp-voc-data-sample"
FILE_NAME = "서비스문의 목록(샘플2).xls"

# STEP 2. 데이터 불러오기
@st.cache_data(ttl=600)
def load_excel():
    try:
        blob_service = BlobServiceClient.from_connection_string(STORAGE_CONNECTION_STRING)
        blob_client = blob_service.get_container_client(CONTAINER_NAME).get_blob_client(FILE_NAME)
        blob_data = blob_client.download_blob().readall()
        return pd.read_excel(BytesIO(blob_data), engine="xlrd")
    except Exception as e:
        st.error(f"📂 엑셀 파일 로딩 실패: {e}")
        return pd.DataFrame()

df = load_excel()

# STEP 3. Sample Prompt
advanced_sample = """
문의 제목: "신규가입시 선호번호 조회 안되어 문의"
-> 주요 키워드: 선호번호
-> 세부 이슈: 신규가입 시 선호번호 조회 불가
-> 의미적 군집: 선호번호 조회 실패

문의 제목: "번호변경시 선호번호 조회되지 않아 확인요청 문의"
-> 주요 키워드: 선호번호
-> 세부 이슈: 번호변경 중 선호번호 조회 안 됨
-> 의미적 군집: 선호번호 조회 실패
"""

# STEP 4. Helper Functions
def parse_gpt_response(content: str) -> dict:
    match = re.search(r"\{.*\}", content, re.DOTALL)
    if match:
        try:
            return json.loads(match.group(0))
        except:
            pass
    return {"keyword": [], "issue": [], "cluster": "기타"}

def extract_features_gpt(title: str) -> dict:
    prompt = f"""
아래는 예시입니다:
{advanced_sample}

문의 제목: "{title}"

아래와 같은 JSON 형식으로 반환:
{{
"keyword": [...],
"issue": [...],
"cluster": "..."
}}
"""
    try:
        response = client.chat.completions.create(
            model=CHAT_DEPLOYMENT_NAME,
            messages=[{"role": "user", "content": prompt}]
        )
        return parse_gpt_response(response.choices[0].message.content.strip())
    except:
        return {"keyword": [], "issue": [], "cluster": "기타"}

@st.cache_data(ttl=900, show_spinner=False)
def analyze_titles_parallel(titles):
    results = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=10) as executor:
        futures = {executor.submit(extract_features_gpt, t): t for t in titles}
        for future in concurrent.futures.as_completed(futures):
            title = futures[future]
            try:
                result = future.result()
            except:
                result = {"keyword": [], "issue": [], "cluster": "기타"}
            results.append((title, result))
    return results

@st.cache_data(ttl=600)
def cluster_to_meta_cluster(clusters):
    prompt = f"""
다음은 VOC 군집명 목록입니다. 의미상 유사한 군집을 최대 5~10개의 메타 카테고리로 묶어주세요:

{json.dumps(list(clusters), ensure_ascii=False)}

예시:
{{
"가입/해지 이슈": ["신규가입 오류", "해지 실패"],
"요금/결제": ["요금 과다", "청구 누락"]
}}
"""
    try:
        response = client.chat.completions.create(
            model=CHAT_DEPLOYMENT_NAME,
            messages=[{"role": "user", "content": prompt}]
        )
        content = response.choices[0].message.content.strip()
        return json.loads(re.search(r"\{.*\}", content, re.DOTALL).group(0))
    except:
        return {}

# STEP 5. Streamlit UI 구성
st.title("📊 GPT 기반 VOC 메타카테고리 네트워크 분석")

with st.sidebar:
    st.subheader("🔍 키워드 검색")
    col1, col2 = st.columns([4, 1])
    with col1:
        search = st.text_input(" ", placeholder="예: 유심, 요금", label_visibility="collapsed")
    with col2:
        search_btn = st.button("조회")

    st.markdown("#### 📂 메타 카테고리 검색")
    meta_input = st.text_area("검색할 메타 키워드 입력 (쉼표/엔터)", height=80, placeholder="예: 요금, 가입")
    meta_search_btn = st.button("메타 카테고리 조회")

    st.markdown("---")
    sample_size = st.slider("분석할 최대 문의 수", 10, 1000, 100)
    cluster_limit = st.slider("군집 수 (메타당)", 1, 10, 3)
    title_limit = st.slider("문의 제목 수 (군집당)", 1, 20, 5)

# 전처리 함수
def clean_str(s): return re.sub(r"\s+", "", str(s)).lower()
def parse_meta_input(inp):
    return [clean_str(x) for x in re.split(r"[,|\n]", inp) if x.strip()]

# STEP 6. 키워드 검색 필터
if search_btn:
    df["_cleaned"] = df["문의제목"].apply(clean_str)
    filtered_df = df[df["_cleaned"].str.contains(clean_str(search))]
elif not search:
    filtered_df = df.sample(n=sample_size) if len(df) > sample_size else df
else:
    st.stop()

# STEP 7. GPT 분석 실행
if filtered_df.empty:
    st.warning("📭 조건에 맞는 문의가 없습니다.")
    st.stop()

with st.spinner("🤖 GPT 분석 중..."):
    analysis_results = analyze_titles_parallel(filtered_df["문의제목"].tolist())

    # ① 클러스터 빈도수 계산
    cluster_counts = Counter([r['cluster'] for _, r in analysis_results])

    # ② 초기 meta_mapping
    all_clusters = set(cluster_counts.keys())
    raw_meta_mapping = cluster_to_meta_cluster(all_clusters)

    # ③ meta 빈도 계산 (메타당 전체 포함된 클러스터 빈도 합)
    meta_counts = {
        meta: sum(cluster_counts.get(cluster, 0) for cluster in clusters)
        for meta, clusters in raw_meta_mapping.items()
    }

    # ④ 클러스터 정렬: 메타별 클러스터를 빈도순으로 정렬
    meta_mapping = {
        meta: sorted(
            clusters,
            key=lambda c: cluster_counts.get(c, 0),
            reverse=True
        )
        for meta, clusters in raw_meta_mapping.items()
    }

    # ⑤ 메타 정렬: 메타도 VOC 인입 건수가 많은 순으로 재정렬
    meta_mapping = dict(
        sorted(meta_mapping.items(), key=lambda item: meta_counts.get(item[0], 0), reverse=True)
    )

def match_metas_by_partial_keywords(user_inputs, meta_mapping):
    result = {}
    for meta, clusters in meta_mapping.items():
        if any(query in clean_str(meta) for query in user_inputs):
            result[meta] = clusters
    return result

# STEP 8. 그래프 생성 함수
def create_network_graph(results, meta_map, cluster_limit, title_limit):
    import networkx as nx
    import plotly.graph_objects as go
    from collections import defaultdict, Counter

    G = nx.Graph()

    title_info_map = {t: r for t, r in results}
    cluster_counts = Counter([r["cluster"] for _, r in results])
    meta_counts = {
        meta: sum(cluster_counts.get(c, 0) for c in clusters)
        for meta, clusters in meta_map.items()
    }

    for meta in meta_map:
        meta_freq = meta_counts.get(meta, 1)
        G.add_node(meta, node_type="meta", frequency=meta_freq)
        clusters = meta_map[meta][:cluster_limit]

        for cluster in clusters:
            cluster_freq = cluster_counts.get(cluster, 1)
            G.add_node(cluster, node_type="cluster", frequency=cluster_freq)
            G.add_edge(meta, cluster)

            # 타이틀 추출
            titles = [(t, r) for t, r in results if r["cluster"] == cluster][:title_limit]
            for title, r in titles:
                G.add_node(title, node_type="title", frequency=1)
                G.add_edge(cluster, title)
                for issue in r["issue"]:
                    G.add_node(issue, node_type="issue", frequency=1)
                    G.add_edge(title, issue)

    # 레이아웃 계산
    pos = nx.spring_layout(G, dim=3, seed=42, k=1.0)
    x_nodes = [pos[n][0] for n in G.nodes()]
    y_nodes = [pos[n][1] for n in G.nodes()]
    z_nodes = [pos[n][2] for n in G.nodes()]

    x_edges, y_edges, z_edges = [], [], []
    for edge in G.edges():
        x_edges += [pos[edge[0]][0], pos[edge[1]][0], None]
        y_edges += [pos[edge[0]][1], pos[edge[1]][1], None]
        z_edges += [pos[edge[0]][2], pos[edge[1]][2], None]

    highlight_node = st.sidebar.selectbox("🔦 강조할 메타 카테고리 선택", [""] + list(meta_map.keys()))

    node_color, node_size, node_labels, node_hovertexts = [], [], [], []

    def scale_size(freq, base=8, max_scale=40):
        return min(base + freq * 2, max_scale)

    for n in G.nodes():
        t = G.nodes[n].get("node_type", "")
        freq = G.nodes[n].get("frequency", 1)
        is_highlight = highlight_node and (n == highlight_node or (highlight_node in G and n in G[highlight_node]))

        # 기본값
        color = "lightgray"
        size = scale_size(freq)
        label = n if t == "meta" else ""
        hover_text = f"<b>{n}</b><br>유형: {t}<br>빈도: {freq}"

        if t == "meta":
            color = "crimson" if is_highlight else "#B22222"
        elif t == "cluster":
            color = "orange" if is_highlight else "#FFA500"
        elif t == "title":
            color = "gainsboro" if not is_highlight else "darkgray"
            r = title_info_map.get(n)
            if r:
                hover_text = f"<b>{n}</b><br>유형: {t}<br>Issue: {', '.join(r['issue'])}"
        elif t == "issue":
            color = "steelblue" if is_highlight else "lightblue"

        node_color.append(color)
        node_size.append(size)
        node_labels.append(label)
        node_hovertexts.append(hover_text)

    fig = go.Figure(data=[
        go.Scatter3d(
            x=x_edges, y=y_edges, z=z_edges,
            mode="lines",
            line=dict(color="lightgray", width=2),
            hoverinfo="none"
        ),
        go.Scatter3d(
            x=x_nodes, y=y_nodes, z=z_nodes,
            mode="markers+text",
            text=node_labels,
            hovertext=node_hovertexts,
            hovertemplate="%{hovertext}<extra></extra>",
            textposition="top center",
            marker=dict(
                size=node_size,
                color=node_color,
                line=dict(color="black", width=1.2)
            )
        )
    ], layout=go.Layout(
        title="🧠 GPT 기반 VOC 네트워크 (빈도 기반 정렬)",
        width=1100,
        height=800,
        scene=dict(
            xaxis=dict(showbackground=False),
            yaxis=dict(showbackground=False),
            zaxis=dict(showbackground=False)
        ),
        margin=dict(l=0, r=0, b=0, t=60)
    ))

    st.plotly_chart(fig, use_container_width=True)


# STEP 9. 메타 검색 버튼 처리
if meta_search_btn:
    meta_queries = parse_meta_input(meta_input)
    matched_meta = match_metas_by_partial_keywords(meta_queries, meta_mapping)

    if not matched_meta:
        st.warning("❗ 검색 키워드를 포함한 메타 카테고리를 찾을 수 없습니다.")
        st.stop()
    else:
        st.subheader("📌 필터된 메타 기반 네트워크")
        create_network_graph(analysis_results, matched_meta, cluster_limit, title_limit)
        st.stop()



# STEP 10. 전체 결과 출력 지점
st.subheader("📌 전체 VOC 네트워크")
create_network_graph(analysis_results, meta_mapping, cluster_limit, title_limit)
